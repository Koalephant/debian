NAME = 'debian-test-vagrant'



Vagrant.configure(2) do |config|

	# (10..12).each do |version|
	#
	# end

	config.vm.define "debian10-amd64" do |machine|
		machine.vm.box = "koalephant/debian10-amd64"
	end

	config.vm.define "debian10-arm64" do |machine|
		machine.vm.box = "koalephant/debian10-arm64"
	end

	config.vm.define "debian10-i386" do |machine|
		machine.vm.box = "koalephant/debian10-i386"
	end

	config.vm.define "debian11-amd64" do |machine|
		machine.vm.box = "koalephant/debian11-amd64"
	end

	config.vm.define "debian11-arm64" do |machine|
		machine.vm.box = "koalephant/debian11-arm64"
	end

	config.vm.define "debian11-i386" do |machine|
		machine.vm.box = "koalephant/debian11-i386"
	end

	config.vm.define "debian12-amd64" do |machine|
		machine.vm.box = "koalephant/debian12-amd64"
	end

	config.vm.define "debian12-arm64" do |machine|
		machine.vm.box = "koalephant/debian12-arm64-test"
	end

	config.vm.define "debian12-i386" do |machine|
		machine.vm.box = "koalephant/debian12-i386"
